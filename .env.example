# Copy this file to .env and adjust values for local development.
# These are placeholders, not production secrets.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Application database role created on first volume init
APP_DB_USER=scaleurl
APP_DB_PASSWORD=scaleurl_dev_password
APP_DB_NAME=scaleurl

# Used by the API process running on the host
DATABASE_URL=postgresql://scaleurl:scaleurl_dev_password@127.0.0.1:5432/scaleurl

# Redis (Docker Compose)
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
