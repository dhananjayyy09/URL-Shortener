# Copy this file to .env and adjust values for local development.
# These are placeholders, not production secrets.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Base URL used to build returned short links (no trailing slash needed)
PUBLIC_BASE_URL=http://localhost:3000

# Redirect cache TTL in seconds (positive integer); never exceeds a URL's remaining lifetime
URL_CACHE_TTL_SECONDS=300

# Fixed-window rate limits per client IP (positive integers; development defaults)
CREATE_URL_RATE_LIMIT_MAX=20
CREATE_URL_RATE_LIMIT_WINDOW_SECONDS=60
REDIRECT_RATE_LIMIT_MAX=120
REDIRECT_RATE_LIMIT_WINDOW_SECONDS=60

# Reverse proxies allowed to set X-Forwarded-For: false, or comma-separated IPs/CIDRs
# (e.g. 10.0.0.5,172.16.0.0/12) or loopback/linklocal/uniquelocal. Never "true".
TRUST_PROXY=false

# PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Application database role created on first volume init
APP_DB_USER=scaleurl
APP_DB_PASSWORD=scaleurl_dev_password
APP_DB_NAME=scaleurl

# Used by the API process running on the host
DATABASE_URL=postgresql://scaleurl:scaleurl_dev_password@127.0.0.1:5432/scaleurl

# Redis (Docker Compose)
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
